# ZTA Gateway environment configuration (copy to .env — .env is gitignored).
#
# Real email delivery. When MAIL_SERVER is unset the app falls back to
# lab mode (message printed to the console + forensic log).

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=your-address@gmail.com
# For Gmail use an App Password (not your account password).
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-address@gmail.com

# --- Email warning feature (Phase 10) ---
ZTA_NOTIFY=1
ZTA_NOTIFY_COOLDOWN_MINUTES=10
ZTA_NOTIFY_MIN_WINDOWS=1
ZTA_NOTIFY_BAN_NOTICE=1
# Optional: copy the administrator on every notice.
ZTA_NOTIFY_ADMIN_COPY=
