# Non-secret switches for the ZTA Gateway systemd unit.
# Install to /etc/zta.env (see deploy/zta-gateway.service).
# Real secrets (MAIL_PASSWORD, SECRET_KEY) stay in the repo's .env, chmod 600.

ZTA_PORTAL_GATE=1
ZTA_INTERNAL_IFACES=eth1
ZTA_UPLINK_IFACE=eth0
ZTA_SESSION_TTL_MINUTES=30
ZTA_DNS_INTERCEPT=1
# Comma-separated MACs that are never gated or auto-banned (access point, admin
# laptop). Leave empty until you know them.
#ZTA_INFRA_MACS=aa:bb:cc:dd:ee:ff,11:22:33:44:55:66

# ARP-retry window when resolving a client MAC at sign-in (seconds).
ZTA_MAC_LOOKUP_TIMEOUT=2.0
# Typed email verification code: validity, tries, and lockout.
ZTA_VERIFY_CODE_TTL_MINUTES=15
ZTA_VERIFY_CODE_MAX_TRIES=5
ZTA_VERIFY_CODE_LOCK_MINUTES=15
